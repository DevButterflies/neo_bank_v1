# ---------------------------------------------------------------------------
# Bank Microservices - environment template
# Copy to .env and adjust per environment. Prefix: BANK_
# ---------------------------------------------------------------------------

# Orchestrator
BANK_SERVICE_NAME=orchestrator
BANK_DATABASE_URL=sqlite+aiosqlite:///./data/orchestrator.db
BANK_API_PREFIX=/api/v1
BANK_LOG_LEVEL=INFO
BANK_LOG_JSON=false

# Downstream service URLs (docker compose service names)
BANK_PILLAR2_URL=http://localhost:8002
BANK_PILLAR3_URL=http://localhost:8003
BANK_PILLAR4_URL=http://localhost:8004

# Pillar 2
BANK_P2_ENGINE_SQLITE_PATH=./data/pillar2.db

# Pillar 3
BANK_P3_ENGINE_SQLITE_PATH=./data/pillar3.db

# Pillar 4
BANK_P4_ENGINE_SQLITE_PATH=./data/pillar4.db